# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
SESSION_SECRET=replace-with-a-long-random-secret

# Optional integrations (uncomment and set values to enable the related features)
# GEMINI_API_KEY=your-google-gemini-api-key          # AI receipt scanning
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_FALLBACK_MODEL=

# MAIL_FROM=you@verified-domain.com                  # Sending verification / password-recovery emails
# MAIL_FROM_NAME=Expense Tracker
# BREVO_API_KEY=your-brevo-api-key                   # (or use RESEND_API_KEY below)
# RESEND_API_KEY=your-resend-api-key

# VAPID_PUBLIC_KEY=your-vapid-public-key             # Group push notifications
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@example.com

# PORT=3000                                          # override the default port